# 서버
PORT=3000
NODE_ENV=development

# MySQL (Prisma) - 실제 값으로 교체해서 .env 로 복사해서 사용
# mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/talkquest"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="14d"

# OAuth Provider (사용자 정보 조회 API)
KAKAO_USER_INFO_URL="https://kapi.kakao.com/v2/user/me"
NAVER_USER_INFO_URL="https://openapi.naver.com/v1/nid/me"

# 이메일 발송 (Resend). 비워두면 실제 발송 없이 로그로만 인증번호를 출력한다.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Firebase Cloud Messaging
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
