  @@unique([user_id, mission_id])
  @@index([mission_id])
  @@map("Mission_Saves")
}

// ----------------------------
// Mission_Setups (미션 준비 정보)
// Missions 1 : N Mission_Setups 1 : N Conversations
//
// 미션 창에서 사용자가 고른 상황 설정(환경/상대 역할/친밀도/예절 수준/성별/나이대 + 주제)을
// 한 행으로 남긴다. 계층 원칙상 이 값은 **개별 대화에만 주입되는 연출 정보**이며,
// Missions나 Mission_Playbooks로 거슬러 올라가지 않는다 — 그 두 계층은 여러 사용자가 공유하므로
// 한 사용자의 설정이 새면 다른 사용자의 대화까지 물든다(Missions 모델 주석 참고).
//
// Conversations에 컬럼으로 붙이지 않고 별도 테이블로 뺀 이유:
//  - 같은 설정으로 대화를 다시 시작하는 경우가 있어 설정과 대화의 수명이 다르다.
//  - 축이 6개라 Conversations가 넓어지고, 축이 늘 때마다 대화 테이블을 건드려야 한다.
//  - "어떤 설정 조합이 많이 쓰이는지"를 대화 이력과 무관하게 집계해야 한다.
// 대화를 시작하지 않고 설정만 하고 이탈한 행도 남는다(어느 조합에서 이탈하는지 신호가 된다).
// ----------------------------
model Mission_Setups {
  id         String @id @default(uuid()) @db.Char(36)
  mission_id String @db.Char(36)
  user_id    String @db.Char(36)

  environment       MissionEnvironment
  partner_role      MissionPartnerRole
  partner_gender    MissionPartnerGender
  partner_age_group MissionPartnerAgeGroup
  // 관계 친밀도 1(매우 낯선 사이) ~ 3(보통) ~ 5(매우 친한 사이).
  // enum이 아니라 정수인 이유 — 프롬프트에서 "n 이상이면 반말 허용"처럼 크기 비교를 하고,
  // 단계 라벨이 바뀌어도 저장값과 마이그레이션이 흔들리지 않아야 한다.
  intimacy_level    Int                    @db.TinyInt
  // 대화 예절 수준 1(반말) ~ 3(보통) ~ 5(매우 격식 있는 존댓말). 위와 같은 이유로 정수.
  formality_level   Int                    @db.TinyInt

  // 대화 주제(selected_topic)는 여기에 두지 않는다. Conversations.selected_topic이
  // 자유 입력으로 존재했지만 어떤 프롬프트에도 들어가지 않는 표시 전용 값이었고,
  // 이 테이블이 정의하는 것은 "말투와 관계"이지 "소재"가 아니다.
  // 자리만 옮기면 아무 역할 없는 필드가 그대로 따라오므로 폐기했다.

  created_at DateTime @default(now())

  mission       Missions        @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  user          Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversations Conversations[]

  @@index([mission_id])
  // 미션 창 재진입 시 "직전에 쓴 설정"을 기본값으로 복원하는 조회 경로.
  @@index([user_id, mission_id, created_at])
  @@map("Mission_Setups")
}

// ----------------------------
// Conversations
// ----------------------------
model Conversations {
  id               String             @id @default(uuid()) @db.Char(36)
  user_id          String             @db.Char(36)
  mission_id       String             @db.Char(36)
  mode             String?            @db.VarChar(50)
  // 이 대화가 어떤 미션 준비 정보(상황 설정)로 시작됐는지. 설정 없이 바로 시작한 기존 대화와
  // 이 컬럼 도입 이전 대화는 null이다(그 경우 예전처럼 미션 정보만으로 배역을 잡는다).
  // 설정 행이 지워져도 대화 기록은 남아야 하므로 SetNull.
  mission_setup_id String?            @db.Char(36)
  // [deprecated] 대화 시작 시 받던 자유 입력 주제.
  // 어떤 프롬프트에도 주입되지 않아 대화에 아무 영향을 주지 못했고(배역·과제는 미션 제목과
  // 설명만으로 정해진다), 앱도 값을 보내지 않아 사실상 항상 null이다.
  // 상황 설정은 Mission_Setups가 구조화된 축으로 대체한다.
  // 컬럼을 남기는 이유는 기존 대화 데이터와 GET /feedback/{id}의 topic 응답 필드가
  // 이 값을 읽고 있기 때문이다. 앞으로 새로 쓰이지 않는다.
  selected_topic   String?            @db.VarChar(255)
  // 이 대화에서 AI가 맡은 배역(예: "동아리 1년차 선배, 친근한 존댓말").
  // 세션 생성 시 한 번 정해 저장하고 매 턴 시스템 프롬프트에 주입한다.
  // 저장하지 않으면 배역이 메시지 이력에만 남아, 이력 상한(최근 10개)을 넘기는 순간
  // 설정이 사라지고 AI가 도우미 말투로 돌아가는 문제가 생긴다.
  persona          String?            @db.VarChar(255)
  // 사용자가 이 대화에서 해내야 할 행동 한 줄(예: "자기가 본 영화의 인상 깊은 장면을 설명하기").
  // Missions.description은 "~해 보세요"처럼 사용자에게 하는 명령문이라 AI가 자기 지시로 읽고
  // 과제를 먼저 수행해버렸다. 그래서 "사용자의 몫"을 별도로 뽑아 저장하고, 매 턴
  // "이 행동은 당신이 하지 않는다"는 금지 규칙으로 주입한다.
  user_task        String?            @db.VarChar(255)
  // 지금 진행 중인 대화 흐름 단계(Missions.dialogue_playbook.flow의 인덱스).
  // 턴 수로 넘기면 사용자가 아직 그 단계를 해내지 못했는데도 다음으로 가버려서,
  // 사용자 발화가 단계의 통과 조건(advanceWhen)과 의미상 맞을 때만 올린다.
  flow_step        Int                @default(0)
  status           ConversationStatus @default(in_progress)
  started_at       DateTime           @default(now())
  finished_at      DateTime?

  user            Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission         Missions                @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  mission_setup   Mission_Setups?         @relation(fields: [mission_setup_id], references: [id], onDelete: SetNull)
  messages        Conversation_Messages[]
  mission_records Mission_Records[]
  feedbacks       Feedbacks[]
  saved_phrases   Saved_Phrases[]

  @@index([user_id])
  @@index([mission_id])
  @@index([mission_setup_id])
  @@map("Conversations")
}

