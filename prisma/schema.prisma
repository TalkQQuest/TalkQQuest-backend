generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  active
  inactive
  deleted
}

enum Provider {
  email
  kakao
  naver
}

enum PersonalityType {
  introvert
  extrovert
  ambivert
}

enum TermsType {
  terms
  privacy
}

enum PrepItemType {
  question // 추천 질문
  starter // 대화 시작 문장
  tip // 준비 팁
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum MessageRole {
  user
  guide
  system
}

enum MissionResult {
  success
  failure
  avoidance
}

enum MissionRecordStatus {
  in_progress
  completed
}

enum FeedbackStatus {
  pending
  ready
  failed
}

// 미션 추천 결과를 만든 단계 (Recommendation_Logs.source)
enum RecommendationSource {
  llm // 4단계 LLM 생성
  template // 3단계 템플릿 선택
  fallback // 매칭 실패 시 입문 하드 폴백
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum ArchiveItemType {
  conversation
  phrase
  report
  mission
}

enum DeviceTokenPlatform {
  android
  ios
}

enum ReportType {
  growth
  weekly_compare
}

enum CommunityVisibility {
  public
  private
}

enum CommunityStatus {
  draft
  open
  closed
}

enum CommunityMemberRole {
  host
  member
}

enum JoinRequestStatus {
  pending
  approved
  rejected
  cancelled
  waitlisted
}

// ============================================================
// MODELS
// ============================================================

// ----------------------------
// Users
// 서비스 사용자 정보. 인증 수단은 Auth_Identities로 분리.
// ----------------------------
model Users {
  id              String     @id @default(uuid()) @db.Char(36)
  name            String     @db.VarChar(50)
  terms_agreed_at DateTime?
  created_at      DateTime   @default(now())
  last_login_at   DateTime?
  status          UserStatus @default(active)
  deleted_at      DateTime?

  // Relations
  auth_identities         Auth_Identities[]
  refresh_tokens          Refresh_Tokens[]
  user_profile            User_Profiles?
  goals                   Goals[]
  mission_saves           Mission_Saves[]
  conversations           Conversations[]
  mission_records         Mission_Records[]
  xp_history              XP_History[]
  feedbacks               Feedbacks[]
  saved_phrases           Saved_Phrases[]
  recommendation_logs     Recommendation_Logs[]
  usages                  Usage[]
  payments                Payments[]
  subscriptions           Subscriptions[]
  user_badges             User_Badges[]
  notifications           Notifications[]
  archive_folders         Archive_Folders[]
  archive_items           Archive_Items[]
  blocked_by_me           Blocked_Users[]           @relation("BlockedUsers_User")
  blocked_me              Blocked_Users[]           @relation("BlockedUsers_BlockedUser")
  device_tokens           Device_Tokens[]
  reports                 Reports[]
  login_history           Login_History[]
  notification_setting    Notification_Settings?
  hosted_communities      Communities[]             @relation("Communities_Host")
  chat_messages           Chat_Messages[]
  calendar_events         Calendar_Events[]
  community_join_requests Community_Join_Requests[]
  community_memberships   Community_Members[]

  @@map("Users")
}

// ----------------------------
// Auth_Identities
// 1 User : N 로그인 수단
// ----------------------------
model Auth_Identities {
  id               String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         Provider
  provider_user_id String?  @db.VarChar(255)
  email            String?  @db.VarChar(255)
  password_hash    String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@unique([provider, email])
  @@map("Auth_Identities")
}

// ----------------------------
// Refresh_Tokens
// ----------------------------
model Refresh_Tokens {
  id          String   @id @default(uuid()) @db.Char(36)
  user_id     String   @db.Char(36)
  token       String   @unique @db.VarChar(512)
  device_info Json?
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Refresh_Tokens")
}

// ----------------------------
// Terms
// ----------------------------
model Terms {
  id         String    @id @default(uuid()) @db.Char(36)
  type       TermsType
  version    String    @db.VarChar(20)
  content    String    @db.Text
  is_active  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("Terms")
}

// ----------------------------
// User_Profiles
// ----------------------------
model User_Profiles {
  id                      String           @id @default(uuid()) @db.Char(36)
  user_id                 String           @unique @db.Char(36)
  nickname                String?          @db.VarChar(50)
  status_type             String?          @db.VarChar(50)
  personality_type        PersonalityType?
  difficult_situations    Json?
  preferred_style         String?          @db.VarChar(255)
  interests               Json?
  purpose                 Json? // 연습하고 싶은 대화 유형 배열 (최대 2개)
  avatar_url              String?          @db.VarChar(500)
  bio                     String?          @db.Text
  daily_conversation_goal Int              @default(1)
  level                   Int              @default(1)
  xp                      Int              @default(0)
  onboarding_completed    Boolean          @default(false)
  onboarding_step         Int              @default(0)
  onboarding_temp_data    Json?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("User_Profiles")
}

// ----------------------------
// Goals
// ----------------------------
model Goals {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  goal_type  String   @db.VarChar(50)
  target     String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Goals")
}

// ----------------------------
// Missions
// ----------------------------
model Missions {
  id                String   @id @default(uuid()) @db.Char(36)
  title             String   @db.VarChar(255)
  description       String   @db.Text
  preparation_tip   String?  @db.Text
  caution           String?  @db.Text
  difficulty        Int
  estimated_minutes Int
  reward_xp         Int      @default(0)
  category          String   @db.VarChar(100)
  is_template       Boolean  @default(false)
  // 이 미션의 대화 진행 지침(flow + responseRules). 미션당 1회 생성해 캐시하고 모든 사용자가
  // 재사용한다 — 흐름은 미션의 속성이라 세션마다 달라질 이유가 없고, LLM 비용도 세션 수가
  // 아니라 미션 수에 비례하게 된다(Mission_Prep_Items 첫 마디 캐시와 같은 방식).
  // responseRules의 각 항목은 "when" 조건의 임베딩을 함께 들고 있어, 사용자 발화와 의미로
  // 대조해 관련 있는 규칙만 골라 프롬프트에 넣는다(전부 넣으면 매 턴 토큰이 커진다).
  dialogue_playbook Json?
  created_at        DateTime @default(now())

  // Relations
  prep_items      Mission_Prep_Items[]
  saves           Mission_Saves[]
  conversations   Conversations[]
  mission_records Mission_Records[]

  @@map("Missions")
}

// ----------------------------
// Mission_Prep_Items
// ----------------------------
model Mission_Prep_Items {
  id          String       @id @default(uuid()) @db.Char(36)
  mission_id  String       @db.Char(36)
  type        PrepItemType
  content     String       @db.Text
  order_index Int          @default(0)
  created_at  DateTime     @default(now())

  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@map("Mission_Prep_Items")
}

// ----------------------------
// Mission_Saves
// ----------------------------
model Mission_Saves {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  mission_id String   @db.Char(36)
  created_at DateTime @default(now())

  user    Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id])
  @@index([mission_id])
  @@map("Mission_Saves")
}

// ----------------------------
// Conversations
// ----------------------------
model Conversations {
  id             String             @id @default(uuid()) @db.Char(36)
  user_id        String             @db.Char(36)
  mission_id     String             @db.Char(36)
  mode           String?            @db.VarChar(50)
  selected_topic String?            @db.VarChar(255)
  // 이 대화에서 AI가 맡은 배역(예: "동아리 1년차 선배, 친근한 존댓말").
  // 세션 생성 시 한 번 정해 저장하고 매 턴 시스템 프롬프트에 주입한다.
  // 저장하지 않으면 배역이 메시지 이력에만 남아, 이력 상한(최근 10개)을 넘기는 순간
  // 설정이 사라지고 AI가 도우미 말투로 돌아가는 문제가 생긴다.
  persona        String?            @db.VarChar(255)
  // 사용자가 이 대화에서 해내야 할 행동 한 줄(예: "자기가 본 영화의 인상 깊은 장면을 설명하기").
  // Missions.description은 "~해 보세요"처럼 사용자에게 하는 명령문이라 AI가 자기 지시로 읽고
  // 과제를 먼저 수행해버렸다. 그래서 "사용자의 몫"을 별도로 뽑아 저장하고, 매 턴
  // "이 행동은 당신이 하지 않는다"는 금지 규칙으로 주입한다.
  user_task      String?            @db.VarChar(255)
  // 지금 진행 중인 대화 흐름 단계(Missions.dialogue_playbook.flow의 인덱스).
  // 턴 수로 넘기면 사용자가 아직 그 단계를 해내지 못했는데도 다음으로 가버려서,
  // 사용자 발화가 단계의 통과 조건(advanceWhen)과 의미상 맞을 때만 올린다.
  flow_step      Int                @default(0)
  status         ConversationStatus @default(in_progress)
  started_at     DateTime           @default(now())
  finished_at    DateTime?

  user            Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission         Missions                @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  messages        Conversation_Messages[]
  mission_records Mission_Records[]
  feedbacks       Feedbacks[]
  saved_phrases   Saved_Phrases[]

  @@index([user_id])
  @@index([mission_id])
  @@map("Conversations")
}

// ----------------------------
// Conversation_Messages
// ----------------------------
model Conversation_Messages {
  id              String      @id @default(uuid()) @db.Char(36)
  conversation_id String      @db.Char(36)
  role            MessageRole
  content         String      @db.Text
  created_at      DateTime    @default(now())

  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("Conversation_Messages")
}

// ----------------------------
// Mission_Records
// ----------------------------
model Mission_Records {
  id               String              @id @default(uuid()) @db.Char(36)
  user_id          String              @db.Char(36)
  mission_id       String              @db.Char(36)
  conversation_id  String?             @db.Char(36)
  result           MissionResult
  memo             String?             @db.Text
  duration_minutes Int?
  emotion          String?             @db.VarChar(50)
  xp_earned        Int                 @default(0)
  status           MissionRecordStatus @default(in_progress)
  created_at       DateTime            @default(now())
  completed_at     DateTime?

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission      Missions       @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  conversation Conversations? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([mission_id])
  @@index([conversation_id])
  @@map("Mission_Records")
}

// ----------------------------
// XP_History
// ----------------------------
model XP_History {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  amount         Int
  reason         String   @db.VarChar(255)
  reference_id   String?  @db.Char(36)
  reference_type String?  @db.VarChar(50)
  created_at     DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("XP_History")
}

// ----------------------------
// Feedbacks
// ----------------------------
model Feedbacks {
  id                   String         @id @default(uuid()) @db.Char(36)
  user_id              String         @db.Char(36)
  // DB에 Feedbacks_conversation_id_key UNIQUE 인덱스가 이미 있었는데(마이그레이션 파일에는 없던 드리프트)
  // 스키마가 이를 반영하지 않고 있었다. 대화당 피드백 1건 규칙과 일치하므로 unique로 명시한다.
  conversation_id      String         @unique @db.Char(36)
  kindness_score       Int?
  initiative_score     Int?
  empathy_score        Int?
  question_link_score  Int?
  // 지표(kindness/initiative/empathy/questionLink) 4개 각각의 상세 결과를
  // [{ key, label, score, strengths, improvements, bestSentence }] 배열로 저장한다.
  // 이슈 #70 진행 중 최유경 님과 구두 미확정 상태에서 이 구조로 가정하고 진행 — 추후 다르게 확정되면 매핑만 수정.
  metrics              Json?
  mission_summary      Json?
  // 대화 전체를 요약하는 키워드 칩 3개(단어 형태, 예: "자기성장", "첫 만남", "스몰토크").
  // conversation 상세·phrase 상세에서 재사용한다(이슈 #83).
  summary_chips        Json?
  // 대화 전체를 2~3문장으로 요약한 텍스트. /archives/conversations/{id}의 summary로 반환한다(이슈 #83).
  conversation_summary String?        @db.Text
  saved_phrase         String?        @db.Text
  status               FeedbackStatus @default(pending)
  created_at           DateTime       @default(now())

  user         Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Feedbacks")
}

// ----------------------------
// Saved_Phrases
// ----------------------------
model Saved_Phrases {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36)
  conversation_id String?  @db.Char(36)
  content         String   @db.Text
  memo            String?  @db.Text
  created_at      DateTime @default(now())

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Conversations? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([conversation_id])
  @@map("Saved_Phrases")
}

// ----------------------------
// Recommendation_Logs
// ----------------------------
model Recommendation_Logs {
  id                  String               @id @default(uuid()) @db.Char(36)
  user_id             String               @db.Char(36)
  source              RecommendationSource
  llm_model           String?              @db.VarChar(50)
  target_difficulty   Int?
  avoided_categories  Json?
  prompt_input        Json?
  raw_response        String?              @db.Text
  parse_success       Boolean              @default(false)
  recommended_mission Json?
  fallback_reason     String?              @db.VarChar(100)
  created_at          DateTime             @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Recommendation_Logs")
}

// ----------------------------
// Usage
// ----------------------------
model Usage {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  // 달력 월(YYYY-MM)이 아니라, 가입일/구독 시작일을 기준으로 한 롤링 1개월 주기의 시작일.
  cycle_start    DateTime @db.Date
  ai_count       Int      @default(0)
  feedback_count Int      @default(0)
  updated_at     DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, cycle_start])
  @@index([user_id])
  @@map("Usage")
}

// ----------------------------
// Plans
// ----------------------------
model Plans {
  id             String   @id @default(uuid()) @db.Char(36)
  name           String   @db.VarChar(100)
  price          Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("KRW") @db.VarChar(3)
  ai_limit       Int?
  feedback_limit Int?
  features       Json?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  subscriptions Subscriptions[]

  @@map("Plans")
}

// ----------------------------
// Subscriptions
// ----------------------------
model Subscriptions {
  id         String             @id @default(uuid()) @db.Char(36)
  user_id    String             @db.Char(36)
  plan_id    String             @db.Char(36)
  status     SubscriptionStatus @default(pending)
  started_at DateTime
  expires_at DateTime?
  created_at DateTime           @default(now())

  user     Users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan     Plans      @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  payments Payments[]

  @@index([user_id])
  @@index([plan_id])
  @@map("Subscriptions")
}

// ----------------------------
// Payments
// ----------------------------
model Payments {
  id              String        @id @default(uuid()) @db.Char(36)
  user_id         String        @db.Char(36)
  subscription_id String?       @db.Char(36)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("KRW") @db.VarChar(3)
  method          String        @db.VarChar(50)
  status          PaymentStatus
  external_id     String?       @db.VarChar(255)
  retry_count     Int           @default(0)
  created_at      DateTime      @default(now())
  completed_at    DateTime?

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription Subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([subscription_id])
  @@map("Payments")
}

// ----------------------------
// Badges / User_Badges
// ----------------------------
model Badges {
  id          String  @id @default(uuid()) @db.Char(36)
  name        String  @db.VarChar(100)
  description String? @db.Text
  condition   Json
  icon_url    String? @db.VarChar(500)

  user_badges User_Badges[]

  @@map("Badges")
}

model User_Badges {
  id        String   @id @default(uuid()) @db.Char(36)
  user_id   String   @db.Char(36)
  badge_id  String   @db.Char(36)
  earned_at DateTime

  user  Users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  badge Badges @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  @@unique([user_id, badge_id])
  @@index([badge_id])
  @@map("User_Badges")
}

// ----------------------------
// Notifications / Notification_Settings
// ----------------------------
model Notifications {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  type           String   @db.VarChar(50)
  title          String   @db.VarChar(255)
  body           String?  @db.Text
  reference_id   String?  @db.Char(36)
  reference_type String?  @db.VarChar(50)
  is_read        Boolean  @default(false)
  created_at     DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Notifications")
}

model Notification_Settings {
  id                 String   @id @default(uuid()) @db.Char(36)
  user_id            String   @unique @db.Char(36)
  mission_reminder   Boolean  @default(true)
  community_approved Boolean  @default(true)
  report_ready       Boolean  @default(true)
  marketing          Boolean  @default(false)
  updated_at         DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Notification_Settings")
}

// ----------------------------
// Archive_Folders / Archive_Items
// ----------------------------
model Archive_Folders {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user  Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items Archive_Items[]

  @@index([user_id])
  @@map("Archive_Folders")
}

model Archive_Items {
  id           String          @id @default(uuid()) @db.Char(36)
  user_id      String          @db.Char(36)
  folder_id    String?         @db.Char(36)
  item_type    ArchiveItemType
  reference_id String          @db.Char(36)
  tags         Json?
  created_at   DateTime        @default(now())

  user   Users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  folder Archive_Folders? @relation(fields: [folder_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([folder_id])
  @@map("Archive_Items")
}

// ----------------------------
// Blocked_Users
// ----------------------------
model Blocked_Users {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36)
  blocked_user_id String   @db.Char(36)
  created_at      DateTime @default(now())

  user         Users @relation("BlockedUsers_User", fields: [user_id], references: [id], onDelete: Cascade)
  blocked_user Users @relation("BlockedUsers_BlockedUser", fields: [blocked_user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, blocked_user_id])
  @@index([blocked_user_id])
  @@map("Blocked_Users")
}

// ----------------------------
// Device_Tokens
// ----------------------------
model Device_Tokens {
  id             String              @id @default(uuid()) @db.Char(36)
  user_id        String              @db.Char(36)
  fcm_token      String              @db.VarChar(500)
  platform       DeviceTokenPlatform @default(android)
  last_active_at DateTime
  created_at     DateTime            @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Device_Tokens")
}

// ----------------------------
// Email_Verifications
// ----------------------------
model Email_Verifications {
  id         String   @id @default(uuid()) @db.Char(36)
  email      String   @db.VarChar(255)
  code       String   @db.VarChar(10)
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("Email_Verifications")
}

// ----------------------------
// Reports
// ----------------------------
model Reports {
  id         String     @id @default(uuid()) @db.Char(36)
  user_id    String     @db.Char(36)
  type       ReportType
  period     String     @db.VarChar(30)
  data       Json?
  created_at DateTime   @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Reports")
}

// ----------------------------
// Login_History
// ----------------------------
model Login_History {
  id           String   @id @default(uuid()) @db.Char(36)
  user_id      String   @db.Char(36)
  device_info  Json?
  ip_address   String?  @db.VarChar(45)
  logged_in_at DateTime

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Login_History")
}

// ----------------------------
// Communities
// ----------------------------
model Communities {
  id              String              @id @default(uuid()) @db.Char(36)
  host_user_id    String              @db.Char(36)
  name            String              @db.VarChar(200)
  description     String?             @db.Text
  category        String?             @db.VarChar(100)
  region          String?             @db.VarChar(100)
  capacity        Int
  current_members Int                 @default(0)
  started_at      DateTime?           @db.Timestamp(0)
  ended_at        DateTime?           @db.Timestamp(0)
  cover_image_url String?             @db.VarChar(500)
  tags            Json?
  visibility      CommunityVisibility @default(public)
  status          CommunityStatus     @default(draft)
  interests       Json?
  created_at      DateTime            @default(now()) @db.Timestamp(0)

  // Relations
  host            Users                     @relation("Communities_Host", fields: [host_user_id], references: [id], onDelete: Cascade)
  chat_messages   Chat_Messages[]
  calendar_events Calendar_Events[]
  join_requests   Community_Join_Requests[]
  members         Community_Members[]

  @@index([host_user_id])
  @@index([status])
  @@map("Communities")
}

// ----------------------------
// Chat_Messages
// ----------------------------
model Chat_Messages {
  id           String   @id @default(uuid()) @db.Char(36)
  community_id String   @db.Char(36)
  user_id      String   @db.Char(36)
  content      String   @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([community_id])
  @@index([user_id])
  @@map("Chat_Messages")
}

// ----------------------------
// Calendar_Events
// ----------------------------
model Calendar_Events {
  id           String    @id @default(uuid()) @db.Char(36)
  user_id      String    @db.Char(36)
  community_id String?   @db.Char(36)
  title        String    @db.VarChar(255)
  started_at   DateTime  @db.Timestamp(0)
  ended_at     DateTime? @db.Timestamp(0)
  created_at   DateTime  @default(now()) @db.Timestamp(0)

  user      Users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  community Communities? @relation(fields: [community_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([community_id])
  @@map("Calendar_Events")
}

// ----------------------------
// Community_Join_Requests
// ----------------------------
model Community_Join_Requests {
  id             String            @id @default(uuid()) @db.Char(36)
  community_id   String            @db.Char(36)
  user_id        String            @db.Char(36)
  status         JoinRequestStatus @default(pending)
  waitlist_order Int? // 대기자 순서
  message        String?           @db.Text
  created_at     DateTime          @default(now()) @db.Timestamp(0)
  updated_at     DateTime          @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@index([community_id])
  @@map("Community_Join_Requests")
}

// ----------------------------
// Community_Members
// ----------------------------
model Community_Members {
  id           String              @id @default(uuid()) @db.Char(36)
  community_id String              @db.Char(36)
  user_id      String              @db.Char(36)
  role         CommunityMemberRole @default(member)
  joined_at    DateTime            @default(now()) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@map("Community_Members")
}
