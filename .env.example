# 서버
PORT=3000
NODE_ENV=development

# MySQL (Prisma) - 실제 값으로 교체해서 .env 로 복사해서 사용
# mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/talkquest"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="14d"

# 이메일 발송 (Resend). 비워두면 실제 발송 없이 로그로만 인증번호를 출력한다.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# 푸시 발송 (Firebase Admin SDK). 비워두면 실제 발송 없이 로그로만 남긴다.
# private_key는 서비스 계정 JSON의 값을 그대로(줄바꿈 \n 이스케이프 포함) 따옴표로 감싸서 넣는다.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# AWS S3 (파일 업로드)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-2"
S3_BUCKET_NAME="talkquest-bucket-424051028041-ap-northeast-2-an"
