// prisma/schema.prisma
// A101 ~ E101까지의 스키마

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  active
  inactive
  deleted
}

enum Provider {
  email
  kakao
  naver
}

enum PersonalityType {
  introvert
  extrovert
  ambivert
}

enum TermsType {
  terms
  privacy
}

enum PrepItemType {
  question // 추천 질문
  starter // 대화 시작 문장
  tip // 준비 팁
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum MessageRole {
  user
  guide
  system
}

enum MissionResult {
  success
  failure
  avoidance
}

enum MissionRecordStatus {
  in_progress
  completed
}

enum FeedbackStatus {
  pending
  ready
  failed
}

// ============================================================
// MODELS
// ============================================================

// ----------------------------
// Users
// 서비스 사용자 정보. 인증 수단은 Auth_Identities로 분리.
// ----------------------------
model Users {
  id              String     @id @default(uuid()) @db.Char(36)
  name            String     @db.VarChar(50)
  school_or_job   String     @db.VarChar(100)
  birth_date      String     @db.VarChar(10)
  terms_agreed_at DateTime?
  created_at      DateTime   @default(now())
  last_login_at   DateTime?
  status          UserStatus @default(active)
  deleted_at      DateTime?

  // Relations
  auth_identities Auth_Identities[]
  refresh_tokens  Refresh_Tokens[]
  user_profile    User_Profiles?
  goals           Goals[]
  mission_saves   Mission_Saves[]
  conversations   Conversations[]
  mission_records Mission_Records[]
  xp_history      XP_History[]
  feedbacks       Feedbacks[]
  saved_phrases   Saved_Phrases[]

  @@map("Users")
}

// ----------------------------
// Auth_Identities
// 1 User : N 로그인 수단
// EMAIL  → email + password_hash, provider_user_id = NULL
// KAKAO/NAVER → provider_user_id, password_hash = NULL
// ----------------------------
model Auth_Identities {
  id               String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         Provider
  provider_user_id String?  @db.VarChar(255)
  email            String?  @db.VarChar(255)
  password_hash    String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user Users @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_user_id])
  @@unique([provider, email])
  @@map("Auth_Identities")
}

// ----------------------------
// Refresh_Tokens
// JWT 재발급 및 로그아웃 처리
// revoked = true → 해당 토큰 무효화
// ----------------------------
model Refresh_Tokens {
  id          String   @id @default(uuid()) @db.Char(36)
  user_id     String   @db.Char(36)
  token       String   @unique @db.VarChar(512)
  device_info Json?
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id])

  @@map("Refresh_Tokens")
}

// ----------------------------
// Terms
// GET /api/v1/terms/latest, GET /api/v1/legal/terms|privacy
// ----------------------------
model Terms {
  id         String    @id @default(uuid()) @db.Char(36)
  type       TermsType
  version    String    @db.VarChar(20)
  content    String    @db.Text
  is_active  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("Terms")
}

// ----------------------------
// User_Profiles
// 온보딩 중 단계별로 채워지므로 대부분 nullable
// ----------------------------
model User_Profiles {
  id                      String           @id @default(uuid()) @db.Char(36)
  user_id                 String           @unique @db.Char(36)
  nickname                String?          @db.VarChar(50)
  status_type             String?          @db.VarChar(50)
  personality_type        PersonalityType?
  difficult_situations    Json?
  preferred_style         String?          @db.VarChar(255)
  interests               Json?
  purpose                 Json? // 연습하고 싶은 대화 유형 배열 (최대 2개) — 기존 String 단일값에서 변경
  avatar_url              String?          @db.VarChar(500)
  bio                     String?          @db.Text
  daily_conversation_goal Int              @default(1)
  level                   Int              @default(1)
  xp                      Int              @default(0)
  onboarding_completed    Boolean          @default(false)
  onboarding_step         Int              @default(0)
  onboarding_temp_data    Json?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  user Users @relation(fields: [user_id], references: [id])

  @@map("User_Profiles")
}

// ----------------------------
// Goals
// POST /api/v1/goals
// ----------------------------
model Goals {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  goal_type  String   @db.VarChar(50)
  target     String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user Users @relation(fields: [user_id], references: [id])

  @@map("Goals")
}

// ----------------------------
// Missions
// preparation_tip: Mission_Prep_Items 분리 후 deprecated 예정
// ----------------------------
model Missions {
  id                String   @id @default(uuid()) @db.Char(36)
  title             String   @db.VarChar(255)
  description       String   @db.Text
  preparation_tip   String?  @db.Text // deprecated 예정 → Mission_Prep_Items로 이전
  caution           String?  @db.Text
  difficulty        Int // 1=쉬움, 2=보통, 3=어려움
  estimated_minutes Int
  reward_xp         Int      @default(0)
  category          String   @db.VarChar(100)
  is_template       Boolean  @default(false)
  created_at        DateTime @default(now())

  // Relations
  prep_items      Mission_Prep_Items[]
  saves           Mission_Saves[]
  conversations   Conversations[]
  mission_records Mission_Records[]

  @@map("Missions")
}

// ----------------------------
// Mission_Prep_Items
// GET /api/v1/missions/{missionId}/prep
// type별로 그룹핑해서 응답 (questions[], starters[], tips[])
// ----------------------------
model Mission_Prep_Items {
  id          String       @id @default(uuid()) @db.Char(36)
  mission_id  String       @db.Char(36)
  type        PrepItemType
  content     String       @db.Text
  order_index Int          @default(0)
  created_at  DateTime     @default(now())

  mission Missions @relation(fields: [mission_id], references: [id])

  @@map("Mission_Prep_Items")
}

// ----------------------------
// Mission_Saves
// POST/DELETE /api/v1/missions/{missionId}/save
// ----------------------------
model Mission_Saves {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  mission_id String   @db.Char(36)
  created_at DateTime @default(now())

  user    Users    @relation(fields: [user_id], references: [id])
  mission Missions @relation(fields: [mission_id], references: [id])

  @@unique([user_id, mission_id])
  @@map("Mission_Saves")
}

// ----------------------------
// Conversations
// POST /api/v1/conversations
// ----------------------------
model Conversations {
  id             String             @id @default(uuid()) @db.Char(36)
  user_id        String             @db.Char(36)
  mission_id     String             @db.Char(36)
  mode           String?            @db.VarChar(50)
  selected_topic String?            @db.VarChar(255)
  status         ConversationStatus @default(in_progress)
  started_at     DateTime           @default(now())
  finished_at    DateTime?

  user            Users                   @relation(fields: [user_id], references: [id])
  mission         Missions                @relation(fields: [mission_id], references: [id])
  messages        Conversation_Messages[]
  mission_records Mission_Records[]
  feedbacks       Feedbacks[]
  saved_phrases   Saved_Phrases[]

  @@map("Conversations")
}

// ----------------------------
// Conversation_Messages
// POST /api/v1/conversations/{id}/messages
// ----------------------------
model Conversation_Messages {
  id              String      @id @default(uuid()) @db.Char(36)
  conversation_id String      @db.Char(36)
  role            MessageRole
  content         String      @db.Text
  created_at      DateTime    @default(now())

  conversation Conversations @relation(fields: [conversation_id], references: [id])

  @@map("Conversation_Messages")
}

// ----------------------------
// Mission_Records
// POST /api/v1/missions/{missionId}/complete
// 트랜잭션: Conversations 종료 + MissionRecord + XP_History + User xp 증가
// ----------------------------
model Mission_Records {
  id               String              @id @default(uuid()) @db.Char(36)
  user_id          String              @db.Char(36)
  mission_id       String              @db.Char(36)
  conversation_id  String?             @db.Char(36)
  result           MissionResult
  memo             String?             @db.Text
  duration_minutes Int?
  emotion          String?             @db.VarChar(50)
  xp_earned        Int                 @default(0)
  status           MissionRecordStatus @default(in_progress)
  created_at       DateTime            @default(now())
  completed_at     DateTime?

  user         Users          @relation(fields: [user_id], references: [id])
  mission      Missions       @relation(fields: [mission_id], references: [id])
  conversation Conversations? @relation(fields: [conversation_id], references: [id])

  @@map("Mission_Records")
}

// ----------------------------
// XP_History
// GET /api/v1/xp/history
// ----------------------------
model XP_History {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  amount         Int // 양수=획득, 음수=차감
  reason         String   @db.VarChar(255)
  reference_id   String?  @db.Char(36) // 직접 지급 등 없을 경우 null
  reference_type String?  @db.VarChar(50) // mission_record / badge / event 등
  created_at     DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id])

  @@map("XP_History")
}

// ----------------------------
// Feedbacks
// POST /api/v1/feedback, GET /api/v1/feedback/{feedbackId}
// status=pending → AI 처리 완료 시 ready, 점수 컬럼 채워짐
// ----------------------------
model Feedbacks {
  id                  String         @id @default(uuid()) @db.Char(36)
  user_id             String         @db.Char(36)
  conversation_id     String         @db.Char(36)
  kindness_score      Int? // pending 상태일 때 null
  initiative_score    Int?
  empathy_score       Int?
  question_link_score Int?
  strengths           Json?
  improvements        Json?
  saved_phrase        String?        @db.Text
  status              FeedbackStatus @default(pending)
  created_at          DateTime       @default(now())

  user         Users         @relation(fields: [user_id], references: [id])
  conversation Conversations @relation(fields: [conversation_id], references: [id])

  @@map("Feedbacks")
}

// ----------------------------
// Saved_Phrases
// POST /api/v1/archives/phrases
// ----------------------------
model Saved_Phrases {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36)
  conversation_id String?  @db.Char(36) // 대화 외 직접 저장 시 null
  content         String   @db.Text
  memo            String?  @db.Text
  created_at      DateTime @default(now())

  user         Users          @relation(fields: [user_id], references: [id])
  conversation Conversations? @relation(fields: [conversation_id], references: [id])

  @@map("Saved_Phrases")
}
