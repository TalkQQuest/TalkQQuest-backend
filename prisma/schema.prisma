// ----------------------------
// Communities
// ----------------------------
model Communities {
  id              String              @id @default(uuid()) @db.Char(36)
  host_user_id    String              @db.Char(36)
  name            String              @db.VarChar(200)
  description     String?             @db.Text
  category        String?             @db.VarChar(100)
  region          String?             @db.VarChar(100)
  address         String?             @db.VarChar(255)
  capacity        Int
  current_members Int                 @default(0)
  started_at      DateTime?           @db.Timestamp(0)
  ended_at        DateTime?           @db.Timestamp(0)
  cover_image_url String?             @db.VarChar(500)
  tags            Json?
  visibility      CommunityVisibility @default(public)
  status          CommunityStatus     @default(draft)
  interests       Json?
  created_at      DateTime            @default(now()) @db.Timestamp(0)

  // Relations
  host            Users                     @relation("Communities_Host", fields: [host_user_id], references: [id], onDelete: Cascade)
  chat_messages   Chat_Messages[]
  calendar_events Calendar_Events[]
  join_requests   Community_Join_Requests[]
  members         Community_Members[]
  bookmarks       Community_Bookmarks[]

  @@index([host_user_id])
  @@index([status])
  @@map("Communities")
}

// ----------------------------
// Chat_Messages
// ----------------------------
model Chat_Messages {
  id           String          @id @default(uuid()) @db.Char(36)
  community_id String          @db.Char(36)
  // 시스템 메시지("OOO님이 입장했습니다")는 특정 유저 발화가 아니라 null이다 (#115).
  user_id      String?         @db.Char(36)
  content      String          @db.Text
  type         ChatMessageType @default(text)
  created_at   DateTime        @default(now()) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  // 채팅 이력 커서 페이지네이션은 community_id로 필터하고 created_at으로 정렬하므로 복합 인덱스로 묶는다.
  @@index([community_id, created_at])
  @@map("Chat_Messages")
}

