  updated_at         DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Notification_Settings")
}

// ----------------------------
// Archive_Folders / Archive_Items
// ----------------------------
model Archive_Folders {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user  Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items Archive_Items[]

  @@index([user_id])
  @@map("Archive_Folders")
}

model Archive_Items {
  id           String          @id @default(uuid()) @db.Char(36)
  user_id      String          @db.Char(36)
  folder_id    String?         @db.Char(36)
  item_type    ArchiveItemType
  reference_id String          @db.Char(36)
  tags         Json?
  created_at   DateTime        @default(now())

  user   Users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  folder Archive_Folders? @relation(fields: [folder_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([folder_id])
  @@map("Archive_Items")
}

// ----------------------------
// Blocked_Users
// ----------------------------
model Blocked_Users {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36)
  blocked_user_id String   @db.Char(36)
  created_at      DateTime @default(now())

  user         Users @relation("BlockedUsers_User", fields: [user_id], references: [id], onDelete: Cascade)
  blocked_user Users @relation("BlockedUsers_BlockedUser", fields: [blocked_user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, blocked_user_id])
  @@index([blocked_user_id])
  @@map("Blocked_Users")
}

// ----------------------------
// Device_Tokens
// ----------------------------
model Device_Tokens {
  id             String              @id @default(uuid()) @db.Char(36)
  user_id        String              @db.Char(36)
  fcm_token      String              @db.VarChar(500)
  platform       DeviceTokenPlatform @default(android)
  last_active_at DateTime
  created_at     DateTime            @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Device_Tokens")
}

// ----------------------------
// Email_Verifications
// ----------------------------
model Email_Verifications {
  id         String   @id @default(uuid()) @db.Char(36)
  email      String   @db.VarChar(255)
  code       String   @db.VarChar(10)
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("Email_Verifications")
}

// ----------------------------
// Reports
// ----------------------------
model Reports {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  period     String   @db.VarChar(30)
  data       Json?
  created_at DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Reports")
}

// ----------------------------
// Login_History
// ----------------------------
model Login_History {
  id           String   @id @default(uuid()) @db.Char(36)
  user_id      String   @db.Char(36)
  device_info  Json?
  ip_address   String?  @db.VarChar(45)
  logged_in_at DateTime

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Login_History")
}

// ----------------------------
// Communities
// ----------------------------
model Communities {
  id              String              @id @default(uuid()) @db.Char(36)
  host_user_id    String              @db.Char(36)
  name            String              @db.VarChar(200)
  description     String?             @db.Text
  category        String?             @db.VarChar(100)
  region          String?             @db.VarChar(100)
  address         String?             @db.VarChar(255)
  capacity        Int
  current_members Int                 @default(0)
  started_at      DateTime?           @db.Timestamp(0)
  ended_at        DateTime?           @db.Timestamp(0)
  cover_image_url String?             @db.VarChar(500)
  tags            Json?
  visibility      CommunityVisibility @default(public)
  status          CommunityStatus     @default(draft)
  interests       Json?
  created_at      DateTime            @default(now()) @db.Timestamp(0)

  // Relations
  host            Users                     @relation("Communities_Host", fields: [host_user_id], references: [id], onDelete: Cascade)
  chat_messages   Chat_Messages[]
  calendar_events Calendar_Events[]
  join_requests   Community_Join_Requests[]
  members         Community_Members[]
  bookmarks       Community_Bookmarks[]

  @@index([host_user_id])
  @@index([status])
  @@map("Communities")
}

// ----------------------------
// Chat_Messages
// ----------------------------
model Chat_Messages {
  id           String          @id @default(uuid()) @db.Char(36)
  community_id String          @db.Char(36)
  // 시스템 메시지("OOO님이 입장했습니다")는 특정 유저 발화가 아니라 null이다 (#115).
  user_id      String?         @db.Char(36)
  content      String          @db.Text
  type         ChatMessageType @default(text)
  created_at   DateTime        @default(now()) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  // 채팅 이력 커서 페이지네이션은 community_id로 필터하고 created_at으로 정렬하므로 복합 인덱스로 묶는다.
  @@index([community_id, created_at])
  @@map("Chat_Messages")
}

// ----------------------------
// Calendar_Events
// ----------------------------
model Calendar_Events {
  id           String    @id @default(uuid()) @db.Char(36)
  user_id      String    @db.Char(36)
  community_id String?   @db.Char(36)
  title        String    @db.VarChar(255)
  started_at   DateTime  @db.Timestamp(0)
  ended_at     DateTime? @db.Timestamp(0)
  created_at   DateTime  @default(now()) @db.Timestamp(0)

  user      Users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  community Communities? @relation(fields: [community_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([community_id])
  @@map("Calendar_Events")
}

// ----------------------------
// Community_Join_Requests
// ----------------------------
model Community_Join_Requests {
  id             String            @id @default(uuid()) @db.Char(36)
  community_id   String            @db.Char(36)
  user_id        String            @db.Char(36)
  status         JoinRequestStatus @default(pending)
  waitlist_order Int? // 대기자 순서
  message        String?           @db.Text
  created_at     DateTime          @default(now()) @db.Timestamp(0)
  updated_at     DateTime          @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@index([community_id])
  @@map("Community_Join_Requests")
}

// ----------------------------
// Community_Members
// ----------------------------
model Community_Members {
  id           String              @id @default(uuid()) @db.Char(36)
  community_id String              @db.Char(36)
  user_id      String              @db.Char(36)
  role         CommunityMemberRole @default(member)
  joined_at    DateTime            @default(now()) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@map("Community_Members")
}

// ----------------------------
// Community_Bookmarks
// ----------------------------
model Community_Bookmarks {
  id           String   @id @default(uuid()) @db.Char(36)
  community_id String   @db.Char(36)
  user_id      String   @db.Char(36)
  created_at   DateTime @default(now()) @db.Timestamp(0)

  community Communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@map("Community_Bookmarks")
}
