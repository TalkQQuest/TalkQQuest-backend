generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  active
  inactive
  deleted
}

enum Provider {
  email
  kakao
  naver
}

enum PersonalityType {
  introvert
  extrovert
  ambivert
}

enum TermsType {
  terms
  privacy
}

enum PrepItemType {
  question // 추천 질문
  starter  // 대화 시작 문장
  tip      // 준비 팁
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum MessageRole {
  user
  guide
  system
}

enum MissionResult {
  success
  failure
  avoidance
}

enum MissionRecordStatus {
  in_progress
  completed
}

enum FeedbackStatus {
  pending
  ready
  failed
}

// 미션 추천 결과를 만든 단계 (Recommendation_Logs.source)
enum RecommendationSource {
  llm      // 4단계 LLM 생성
  template // 3단계 템플릿 선택
  fallback // 매칭 실패 시 입문 하드 폴백
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum ArchiveItemType {
  conversation
  phrase
  report
}

enum DeviceTokenPlatform {
  android
}

enum ReportType {
  monthly
  weekly
}

// ============================================================
// MODELS
// ============================================================

// ----------------------------
// Users
// 서비스 사용자 정보. 인증 수단은 Auth_Identities로 분리.
// ----------------------------
model Users {
  id              String     @id @default(uuid()) @db.Char(36)
  name            String     @db.VarChar(50)
  terms_agreed_at DateTime?
  created_at      DateTime   @default(now())
  last_login_at   DateTime?
  status          UserStatus @default(active)
  deleted_at      DateTime?

  // Relations
  auth_identities      Auth_Identities[]
  refresh_tokens       Refresh_Tokens[]
  user_profile         User_Profiles?
  goals                Goals[]
  mission_saves        Mission_Saves[]
  conversations        Conversations[]
  mission_records      Mission_Records[]
  xp_history           XP_History[]
  feedbacks            Feedbacks[]
  saved_phrases        Saved_Phrases[]
  recommendation_logs  Recommendation_Logs[]
  usages               Usage[]
  payments             Payments[]
  subscriptions        Subscriptions[]
  user_badges          User_Badges[]
  notifications        Notifications[]
  archive_folders      Archive_Folders[]
  archive_items        Archive_Items[]
  blocked_by_me        Blocked_Users[]       @relation("BlockedUsers_User")
  blocked_me           Blocked_Users[]       @relation("BlockedUsers_BlockedUser")
  device_tokens        Device_Tokens[]
  reports              Reports[]
  login_history        Login_History[]
  notification_setting Notification_Settings?

  @@map("Users")
}

// ----------------------------
// Auth_Identities
// 1 User : N 로그인 수단
// ----------------------------
model Auth_Identities {
  id               String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         Provider
  provider_user_id String?  @db.VarChar(255)
  email            String?  @db.VarChar(255)
  password_hash    String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@unique([provider, email])
  @@map("Auth_Identities")
}

// ----------------------------
// Refresh_Tokens
// ----------------------------
model Refresh_Tokens {
  id          String   @id @default(uuid()) @db.Char(36)
  user_id     String   @db.Char(36)
  token       String   @unique @db.VarChar(512)
  device_info Json?
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Refresh_Tokens")
}

// ----------------------------
// Terms
// ----------------------------
model Terms {
  id         String   @id @default(uuid()) @db.Char(36)
  type       TermsType
  version    String   @db.VarChar(20)
  content    String   @db.Text
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("Terms")
}

// ----------------------------
// User_Profiles
// ----------------------------
model User_Profiles {
  id                      String           @id @default(uuid()) @db.Char(36)
  user_id                 String           @unique @db.Char(36)
  nickname                String?          @db.VarChar(50)
  status_type             String?          @db.VarChar(50)
  personality_type        PersonalityType?
  difficult_situations    Json?
  preferred_style         String?          @db.VarChar(255)
  interests               Json?
  purpose                 Json?            // 연습하고 싶은 대화 유형 배열 (최대 2개)
  avatar_url              String?          @db.VarChar(500)
  bio                     String?          @db.Text
  daily_conversation_goal Int              @default(1)
  level                   Int              @default(1)
  xp                      Int              @default(0)
  onboarding_completed    Boolean          @default(false)
  onboarding_step         Int              @default(0)
  onboarding_temp_data    Json?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("User_Profiles")
}

// ----------------------------
// Goals
// ----------------------------
model Goals {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  goal_type  String   @db.VarChar(50)
  target     String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Goals")
}

// ----------------------------
// Missions
// ----------------------------
model Missions {
  id                String   @id @default(uuid()) @db.Char(36)
  title             String   @db.VarChar(255)
  description       String   @db.Text
  preparation_tip   String?  @db.Text 
  caution           String?  @db.Text
  difficulty        Int      
  estimated_minutes Int
  reward_xp         Int      @default(0)
  category          String   @db.VarChar(100)
  is_template       Boolean  @default(false)
  created_at        DateTime @default(now())

  // Relations
  prep_items      Mission_Prep_Items[]
  saves           Mission_Saves[]
  conversations   Conversations[]
  mission_records Mission_Records[]

  @@map("Missions")
}

// ----------------------------
// Mission_Prep_Items
// ----------------------------
model Mission_Prep_Items {
  id          String       @id @default(uuid()) @db.Char(36)
  mission_id  String       @db.Char(36)
  type        PrepItemType
  content     String       @db.Text
  order_index Int          @default(0)
  created_at  DateTime     @default(now())

  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@map("Mission_Prep_Items")
}

// ----------------------------
// Mission_Saves
// ----------------------------
model Mission_Saves {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  mission_id String   @db.Char(36)
  created_at DateTime @default(now())

  user    Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id])
  @@map("Mission_Saves")
}

// ----------------------------
// Conversations
// ----------------------------
model Conversations {
  id             String             @id @default(uuid()) @db.Char(36)
  user_id        String             @db.Char(36)
  mission_id     String             @db.Char(36)
  mode           String?            @db.VarChar(50)
  selected_topic String?            @db.VarChar(255)
  status         ConversationStatus @default(in_progress)
  started_at     DateTime           @default(now())
  finished_at    DateTime?

  user            Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission         Missions                @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  messages        Conversation_Messages[]
  mission_records Mission_Records[]
  feedbacks       Feedbacks[]
  saved_phrases   Saved_Phrases[]

  @@map("Conversations")
}

// ----------------------------
// Conversation_Messages
// ----------------------------
model Conversation_Messages {
  id              String      @id @default(uuid()) @db.Char(36)
  conversation_id String      @db.Char(36)
  role            MessageRole
  content         String      @db.Text
  created_at      DateTime    @default(now())

  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("Conversation_Messages")
}

// ----------------------------
// Mission_Records
// ----------------------------
model Mission_Records {
  id               String              @id @default(uuid()) @db.Char(36)
  user_id          String              @db.Char(36)
  mission_id       String              @db.Char(36)
  conversation_id  String?             @db.Char(36)
  result           MissionResult
  memo             String?             @db.Text
  duration_minutes Int?
  emotion          String?             @db.VarChar(50)
  xp_earned        Int                 @default(0)
  status           MissionRecordStatus @default(in_progress)
  created_at       DateTime            @default(now())
  completed_at     DateTime?

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission      Missions       @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  conversation Conversations? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@map("Mission_Records")
}

// ----------------------------
// XP_History
// ----------------------------
model XP_History {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  amount         Int      
  reason         String   @db.VarChar(255)
  reference_id   String?  @db.Char(36) 
  reference_type String?  @db.VarChar(50) 
  created_at     DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("XP_History")
}

// ----------------------------
// Feedbacks
// ----------------------------
model Feedbacks {
  id                  String         @id @default(uuid()) @db.Char(36)
  user_id             String         @db.Char(36)
  conversation_id     String         @db.Char(36)
  kindness_score      Int?           
  initiative_score    Int?
  empathy_score       Int?
  question_link_score Int?
  strengths           Json?
  improvements        Json?
  saved_phrase        String?        @db.Text
  status              FeedbackStatus @default(pending)
  created_at          DateTime       @default(now())

  user         Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("Feedbacks")
}

// ----------------------------
// Saved_Phrases
// ----------------------------
model Saved_Phrases {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36)
  conversation_id String?  @db.Char(36) 
  content         String   @db.Text
  memo            String?  @db.Text
  created_at      DateTime @default(now())

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Conversations? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@map("Saved_Phrases")
}

// ----------------------------
// Recommendation_Logs
// ----------------------------
model Recommendation_Logs {
  id                  String               @id @default(uuid()) @db.Char(36)
  user_id             String               @db.Char(36)
  source              RecommendationSource 
  llm_model           String?              @db.VarChar(50) 
  target_difficulty   Int?                 
  avoided_categories  Json?                
  prompt_input        Json?                
  raw_response        String?              @db.Text 
  parse_success       Boolean              @default(false) 
  recommended_mission Json?                
  fallback_reason     String?              @db.VarChar(100) 
  created_at          DateTime             @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Recommendation_Logs")
}

// ----------------------------
// Usage
// ----------------------------
model Usage {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  period         String   @db.VarChar(7) 
  ai_count       Int      @default(0) 
  feedback_count Int      @default(0)
  updated_at     DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, period])
  @@map("Usage")
}

// ----------------------------
// Plans
// ----------------------------
model Plans {
  id             String   @id @default(uuid()) @db.Char(36)
  name           String   @db.VarChar(100) 
  price          Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("KRW") @db.VarChar(3)
  ai_limit       Int?     
  feedback_limit Int?
  features       Json?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  subscriptions Subscriptions[]

  @@map("Plans")
}

// ----------------------------
// Subscriptions
// ----------------------------
model Subscriptions {
  id         String             @id @default(uuid()) @db.Char(36)
  user_id    String             @db.Char(36)
  plan_id    String             @db.Char(36)
  status     SubscriptionStatus @default(active)
  started_at DateTime
  expires_at DateTime?
  created_at DateTime           @default(now())

  user     Users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan     Plans      @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  payments Payments[]

  @@map("Subscriptions")
}

// ----------------------------
// Payments
// ----------------------------
model Payments {
  id              String        @id @default(uuid()) @db.Char(36)
  user_id         String        @db.Char(36)
  subscription_id String?       @db.Char(36)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("KRW") @db.VarChar(3)
  method          String        @db.VarChar(50)
  status          PaymentStatus
  external_id     String?       @db.VarChar(255) 
  retry_count     Int           @default(0)
  created_at      DateTime      @default(now())
  completed_at    DateTime?

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription Subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@map("Payments")
}

// ----------------------------
// Badges / User_Badges
// ----------------------------
model Badges {
  id          String  @id @default(uuid()) @db.Char(36)
  name        String  @db.VarChar(100)
  description String? @db.Text
  condition   Json    
  icon_url    String? @db.VarChar(500)

  user_badges User_Badges[]

  @@map("Badges")
}

model User_Badges {
  id        String   @id @default(uuid()) @db.Char(36)
  user_id   String   @db.Char(36)
  badge_id  String   @db.Char(36)
  earned_at DateTime

  user  Users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  badge Badges @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  @@unique([user_id, badge_id])
  @@map("User_Badges")
}

// ----------------------------
// Notifications / Notification_Settings
// ----------------------------
model Notifications {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  type           String   @db.VarChar(50) 
  title          String   @db.VarChar(255)
  body           String?  @db.Text
  reference_id   String?  @db.Char(36)
  reference_type String?  @db.VarChar(50)
  is_read        Boolean  @default(false)
  created_at     DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Notifications")
}

model Notification_Settings {
  id                 String   @id @default(uuid()) @db.Char(36)
  user_id            String   @unique @db.Char(36)
  mission_reminder   Boolean  @default(true)
  community_approved Boolean  @default(true)
  report_ready       Boolean  @default(true)
  marketing          Boolean  @default(false)
  updated_at         DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Notification_Settings")
}

// ----------------------------
// Archive_Folders / Archive_Items
// ----------------------------
model Archive_Folders {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user  Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items Archive_Items[]

  @@map("Archive_Folders")
}

model Archive_Items {
  id           String          @id @default(uuid()) @db.Char(36)
  user_id      String          @db.Char(36)
  folder_id    String?         @db.Char(36)
  item_type    ArchiveItemType
  reference_id String          @db.Char(36)
  tags         Json?
  created_at   DateTime        @default(now())

  user   Users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  folder Archive_Folders? @relation(fields: [folder_id], references: [id], onDelete: SetNull)

  @@map("Archive_Items")
}

// ----------------------------
// Blocked_Users
// ----------------------------
model Blocked_Users {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36) 
  blocked_user_id String   @db.Char(36) 
  created_at      DateTime @default(now())

  user         Users @relation("BlockedUsers_User", fields: [user_id], references: [id], onDelete: Cascade)
  blocked_user Users @relation("BlockedUsers_BlockedUser", fields: [blocked_user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, blocked_user_id])
  @@map("Blocked_Users")
}

// ----------------------------
// Device_Tokens
// ----------------------------
model Device_Tokens {
  id             String              @id @default(uuid()) @db.Char(36)
  user_id        String              @db.Char(36)
  fcm_token      String              @db.VarChar(500)
  platform       DeviceTokenPlatform @default(android)
  last_active_at DateTime
  created_at     DateTime            @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Device_Tokens")
}

// ----------------------------
// Email_Verifications
// ----------------------------
model Email_Verifications {
  id         String   @id @default(uuid()) @db.Char(36)
  email      String   @db.VarChar(255)
  code       String   @db.VarChar(10)
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("Email_Verifications")
}

// ----------------------------
// Reports
// ----------------------------
model Reports {
  id         String     @id @default(uuid()) @db.Char(36)
  user_id    String     @db.Char(36)
  type       ReportType
  period     String     @db.VarChar(10) 
  data       Json?      
  created_at DateTime   @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Reports")
}

// ----------------------------
// Login_History
// ----------------------------
model Login_History {
  id           String   @id @default(uuid()) @db.Char(36)
  user_id      String   @db.Char(36)
  device_info  Json?
  ip_address   String?  @db.VarChar(45)
  logged_in_at DateTime

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Login_History")
}
