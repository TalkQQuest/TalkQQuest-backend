generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  active
  inactive
  deleted
}

enum Provider {
  email
  kakao
  naver
}

enum PersonalityType {
  introvert
  extrovert
  ambivert
}

enum TermsType {
  terms
  privacy
}

enum PrepItemType {
  question // 추천 질문
  starter // 대화 시작 문장
  tip // 준비 팁
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum MessageRole {
  user
  guide
  system
}

enum MissionResult {
  success
  failure
  avoidance
}

enum MissionRecordStatus {
  in_progress
  completed
}

enum FeedbackStatus {
  pending
  ready
  failed
}

// 미션 추천 결과를 만든 단계 (Recommendation_Logs.source)
enum RecommendationSource {
  llm // 4단계 LLM 생성
  template // 3단계 템플릿 선택
  fallback // 매칭 실패 시 입문 하드 폴백
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum ArchiveItemType {
  conversation
  phrase
  report
  mission
  weekly_compare
}

enum DeviceTokenPlatform {
  android
  ios
}

enum CommunityVisibility {
  public
  private
}

enum CommunityStatus {
  draft
  open
  closed
}

enum CommunityMemberRole {
  host
  member
}

enum JoinRequestStatus {
  pending
  approved
  rejected
  cancelled
  waitlisted
}

enum ChatMessageType {
  text
  system
}

// ============================================================
// MODELS
// ============================================================

// ----------------------------
// Users
// 서비스 사용자 정보. 인증 수단은 Auth_Identities로 분리.
// ----------------------------
model Users {
  id              String     @id @default(uuid()) @db.Char(36)
  name            String     @db.VarChar(50)
  terms_agreed_at DateTime?
  created_at      DateTime   @default(now())
  last_login_at   DateTime?
  status          UserStatus @default(active)
  deleted_at      DateTime?

  // Relations
  auth_identities         Auth_Identities[]
  refresh_tokens          Refresh_Tokens[]
  user_profile            User_Profiles?
  goals                   Goals[]
  mission_saves           Mission_Saves[]
  conversations           Conversations[]
  mission_records         Mission_Records[]
  xp_history              XP_History[]
  feedbacks               Feedbacks[]
  saved_phrases           Saved_Phrases[]
  recommendation_logs     Recommendation_Logs[]
  usages                  Usage[]
  payments                Payments[]
  subscriptions           Subscriptions[]
  user_badges             User_Badges[]
  notifications           Notifications[]
  archive_folders         Archive_Folders[]
  archive_items           Archive_Items[]
  blocked_by_me           Blocked_Users[]           @relation("BlockedUsers_User")
  blocked_me              Blocked_Users[]           @relation("BlockedUsers_BlockedUser")
  device_tokens           Device_Tokens[]
  reports                 Reports[]
  weekly_compare_reports  Weekly_Compare_Reports[]
  login_history           Login_History[]
  notification_setting    Notification_Settings?
  hosted_communities      Communities[]             @relation("Communities_Host")
  chat_messages           Chat_Messages[]
  calendar_events         Calendar_Events[]
  community_join_requests Community_Join_Requests[]
  community_memberships   Community_Members[]
  community_bookmarks     Community_Bookmarks[]
  created_missions        Missions[]                @relation("MissionCreatedBy")

  @@map("Users")
}

// ----------------------------
// Auth_Identities
// 1 User : N 로그인 수단
// ----------------------------
model Auth_Identities {
  id               String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         Provider
  provider_user_id String?  @db.VarChar(255)
  email            String?  @db.VarChar(255)
  password_hash    String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@unique([provider, email])
  @@map("Auth_Identities")
}

// ----------------------------
// Refresh_Tokens
// ----------------------------
model Refresh_Tokens {
  id          String   @id @default(uuid()) @db.Char(36)
  user_id     String   @db.Char(36)
  token       String   @unique @db.VarChar(512)
  device_info Json?
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Refresh_Tokens")
}

// ----------------------------
// Terms
// ----------------------------
model Terms {
  id         String    @id @default(uuid()) @db.Char(36)
  type       TermsType
  version    String    @db.VarChar(20)
  content    String    @db.Text
  is_active  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("Terms")
}

// ----------------------------
// User_Profiles
// ----------------------------
model User_Profiles {
  id                      String           @id @default(uuid()) @db.Char(36)
  user_id                 String           @unique @db.Char(36)
  nickname                String?          @db.VarChar(50)
  status_type             String?          @db.VarChar(50)
  personality_type        PersonalityType?
  difficult_situations    Json?
  preferred_style         String?          @db.VarChar(255)
  interests               Json?
  purpose                 Json? // 연습하고 싶은 대화 유형 배열 (최대 2개)
  avatar_url              String?          @db.VarChar(500)
  bio                     String?          @db.Text
  daily_conversation_goal Int              @default(1)
  level                   Int              @default(1)
  xp                      Int              @default(0)
  onboarding_completed    Boolean          @default(false)
  onboarding_step         Int              @default(0)
  onboarding_temp_data    Json?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("User_Profiles")
}

// ----------------------------
// Goals
// ----------------------------
model Goals {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  goal_type  String   @db.VarChar(50)
  target     String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Goals")
}

// ----------------------------
// Missions
// ----------------------------
model Missions {
  id                String   @id @default(uuid()) @db.Char(36)
  title             String   @db.VarChar(255)
  description       String   @db.Text
  preparation_tip   String?  @db.Text
  caution           String?  @db.Text
  difficulty        Int
  estimated_minutes Int
  reward_xp         Int      @default(0)
  category          String   @db.VarChar(100)
  is_template       Boolean  @default(false)
  // AI 추천으로 생성된 미션의 생성자. 관리자 템플릿(is_template=true)과 이 컬럼 도입 이전에
  // 만들어진 미션은 null이다.
  created_by_user_id String? @db.Char(36)
  // 생성 당시 생성자의 성향. 생성자가 나중에 온보딩 성향을 바꿔도 "이 미션이 어떤 성향을 위해
  // 만들어졌는지"는 변하면 안 되므로 Users→User_Profiles 조인 대신 비정규화해 저장한다.
  // 미션 목록의 유사 성향 필터가 이 값을 그대로 쓴다.
  creator_personality_type PersonalityType?
  created_at        DateTime @default(now())

  // Relations
  prep_items      Mission_Prep_Items[]
  saves           Mission_Saves[]
  conversations   Conversations[]
  mission_records Mission_Records[]
  // 대화 진행 지침. 임베딩 때문에 1MB를 넘길 수 있어 별도 테이블로 뺐다 —
  // 필요한 곳에서만 명시적으로 join할 것(Missions를 select 없이 조회하면 딸려오지 않는다).
  playbook        Mission_Playbooks?
  created_by      Users?             @relation("MissionCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  // 이 미션을 만들어낸 추천 로그들(백링크의 반대편).
  created_recommendation_logs Recommendation_Logs[] @relation("RecommendationLogCreatedMission")

  @@index([created_by_user_id])
  // 미션 목록 조회의 주 필터(템플릿 여부 + 유사 성향)를 한 인덱스로 커버한다.
  @@index([is_template, creator_personality_type])
  @@map("Missions")
}

// ----------------------------
// Mission_Prep_Items
// ----------------------------
// ----------------------------
// Mission_Playbooks
// 미션별 대화 진행 지침(flow + responseRules)과 그 임베딩.
//
// Missions에 JSON 컬럼으로 두었더니 미션 1건이 1.1MB까지 커졌다(임베딩 4096차원 × 10개를
// JSON 텍스트로 저장). select 없이 Missions를 조회하는 모든 쿼리가 이걸 통째로 끌고 왔고,
// ORDER BY가 걸리면 MySQL sort_buffer_size(256KB)를 넘겨 `GET /missions`가 500으로 죽었다.
// 별도 테이블로 빼서 **필요한 곳에서만 명시적으로 join**하게 한다.
// ----------------------------
model Mission_Playbooks {
  id         String   @id @default(uuid()) @db.Char(36)
  mission_id String   @unique @db.Char(36)
  // { flow: [{step, advanceExamples, advanceEmbeddings}], responseRules: [{when, then, whenEmbedding}] }
  data       Json
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@map("Mission_Playbooks")
}

model Mission_Prep_Items {
  id          String       @id @default(uuid()) @db.Char(36)
  mission_id  String       @db.Char(36)
  type        PrepItemType
  content     String       @db.Text
  order_index Int          @default(0)
  created_at  DateTime     @default(now())

  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  // 첫 마디 후보는 캐시가 비었을 때 생성되는데, 조회와 삽입 사이에 잠금이 없어
  // 동시 요청이 모두 빈 캐시를 읽으면 같은 미션에 후보가 두 벌 쌓인다.
  // 이 제약이 있으면 뒤늦은 삽입이 skipDuplicates로 조용히 버려진다.
  @@unique([mission_id, type, order_index])
  @@map("Mission_Prep_Items")
}

// ----------------------------
// Mission_Saves
// ----------------------------
model Mission_Saves {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  mission_id String   @db.Char(36)
  created_at DateTime @default(now())

  user    Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id])
  @@index([mission_id])
  @@map("Mission_Saves")
}

// ----------------------------
// Conversations
// ----------------------------
model Conversations {
  id             String             @id @default(uuid()) @db.Char(36)
  user_id        String             @db.Char(36)
  mission_id     String             @db.Char(36)
  mode           String?            @db.VarChar(50)
  selected_topic String?            @db.VarChar(255)
  // 이 대화에서 AI가 맡은 배역(예: "동아리 1년차 선배, 친근한 존댓말").
  // 세션 생성 시 한 번 정해 저장하고 매 턴 시스템 프롬프트에 주입한다.
  // 저장하지 않으면 배역이 메시지 이력에만 남아, 이력 상한(최근 10개)을 넘기는 순간
  // 설정이 사라지고 AI가 도우미 말투로 돌아가는 문제가 생긴다.
  persona        String?            @db.VarChar(255)
  // 사용자가 이 대화에서 해내야 할 행동 한 줄(예: "자기가 본 영화의 인상 깊은 장면을 설명하기").
  // Missions.description은 "~해 보세요"처럼 사용자에게 하는 명령문이라 AI가 자기 지시로 읽고
  // 과제를 먼저 수행해버렸다. 그래서 "사용자의 몫"을 별도로 뽑아 저장하고, 매 턴
  // "이 행동은 당신이 하지 않는다"는 금지 규칙으로 주입한다.
  user_task      String?            @db.VarChar(255)
  // 지금 진행 중인 대화 흐름 단계(Missions.dialogue_playbook.flow의 인덱스).
  // 턴 수로 넘기면 사용자가 아직 그 단계를 해내지 못했는데도 다음으로 가버려서,
  // 사용자 발화가 단계의 통과 조건(advanceWhen)과 의미상 맞을 때만 올린다.
  flow_step      Int                @default(0)
  status         ConversationStatus @default(in_progress)
  started_at     DateTime           @default(now())
  finished_at    DateTime?

  user            Users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission         Missions                @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  messages        Conversation_Messages[]
  mission_records Mission_Records[]
  feedbacks       Feedbacks[]
  saved_phrases   Saved_Phrases[]
  report          Reports?

  @@index([user_id])
  @@index([mission_id])
  @@map("Conversations")
}

// ----------------------------
// Conversation_Messages
// ----------------------------
model Conversation_Messages {
  id              String      @id @default(uuid()) @db.Char(36)
  conversation_id String      @db.Char(36)
  role            MessageRole
  content         String      @db.Text
  created_at      DateTime    @default(now())

  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("Conversation_Messages")
}

// ----------------------------
// Mission_Records
// ----------------------------
model Mission_Records {
  id               String              @id @default(uuid()) @db.Char(36)
  user_id          String              @db.Char(36)
  mission_id       String              @db.Char(36)
  conversation_id  String?             @db.Char(36)
  result           MissionResult
  memo             String?             @db.Text
  duration_minutes Int?
  emotion          String?             @db.VarChar(50)
  xp_earned        Int                 @default(0)
  status           MissionRecordStatus @default(in_progress)
  created_at       DateTime            @default(now())
  completed_at     DateTime?

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission      Missions       @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  conversation Conversations? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([mission_id])
  @@index([conversation_id])
  @@map("Mission_Records")
}

// ----------------------------
// XP_History
// ----------------------------
model XP_History {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  amount         Int
  reason         String   @db.VarChar(255)
  reference_id   String?  @db.Char(36)
  reference_type String?  @db.VarChar(50)
  created_at     DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("XP_History")
}

// ----------------------------
// Feedbacks
// ----------------------------
model Feedbacks {
  id                   String         @id @default(uuid()) @db.Char(36)
  user_id              String         @db.Char(36)
  // DB에 Feedbacks_conversation_id_key UNIQUE 인덱스가 이미 있었는데(마이그레이션 파일에는 없던 드리프트)
  // 스키마가 이를 반영하지 않고 있었다. 대화당 피드백 1건 규칙과 일치하므로 unique로 명시한다.
  conversation_id      String         @unique @db.Char(36)
  kindness_score       Int?
  initiative_score     Int?
  empathy_score        Int?
  question_link_score  Int?
  // 지표(kindness/initiative/empathy/questionLink) 4개 각각의 상세 결과를
  // [{ key, label, score, strengths, improvements, bestSentence }] 배열로 저장한다.
  // 이슈 #70 진행 중 최유경 님과 구두 미확정 상태에서 이 구조로 가정하고 진행 — 추후 다르게 확정되면 매핑만 수정.
  metrics              Json?
  mission_summary      Json?
  // 대화 전체를 요약하는 키워드 칩 3개(단어 형태, 예: "자기성장", "첫 만남", "스몰토크").
  // conversation 상세·phrase 상세에서 재사용한다(이슈 #83).
  summary_chips        Json?
  // 대화 전체를 2~3문장으로 요약한 텍스트. /archives/conversations/{id}의 summary로 반환한다(이슈 #83).
  conversation_summary String?        @db.Text
  saved_phrase         String?        @db.Text
  status               FeedbackStatus @default(pending)
  created_at           DateTime       @default(now())

  user         Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Feedbacks")
}

// ----------------------------
// Saved_Phrases
// ----------------------------
model Saved_Phrases {
  id              String   @id @default(uuid()) @db.Char(36)
  user_id         String   @db.Char(36)
  conversation_id String?  @db.Char(36)
  content         String   @db.Text
  memo            String?  @db.Text
  created_at      DateTime @default(now())

  user         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Conversations? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([conversation_id])
  @@map("Saved_Phrases")
}

// ----------------------------
// Recommendation_Logs
// ----------------------------
model Recommendation_Logs {
  id                  String               @id @default(uuid()) @db.Char(36)
  user_id             String               @db.Char(36)
  source              RecommendationSource 
  llm_model           String?              @db.VarChar(50) 
  target_difficulty   Int?                 
  avoided_categories  Json?                
  prompt_input        Json?                
  raw_response        String?              @db.Text 
  parse_success       Boolean              @default(false) 
  recommended_mission Json?
  fallback_reason     String?              @db.VarChar(100)
  created_mission_id  String?              @db.Char(36) // llm/fallback 추천을 실제 Missions로 저장했을 때 그 id (재요청 시 중복 생성 방지용 백링크)
  // 그날 이 사용자의 몇 번째 추천인지(0 = 첫 추천, 1..N = 새로고침). LLM을 부르기 전에
  // 이 값으로 행을 먼저 만들어 슬롯을 선점한다 — 아래 @@unique가 동시 요청 중 하나만
  // 통과시키므로, count를 읽고 판단하는 방식과 달리 병렬 새로고침이 한도를 넘지 못한다.
  // 이 컬럼 도입 이전 로그는 null이고, MySQL은 unique 인덱스에서 null을 서로 다르게 보므로
  // 과거 데이터끼리 충돌하지 않는다.
  refresh_index       Int?
  // 이 추천이 속한 "하루"(클라이언트 로컬 날짜 기준, YYYY-MM-DD). 오늘의 미션 캐시와
  // 새로고침 횟수 집계의 버킷 키다. created_at(타임스탬프)로 범위를 계산하지 않고 별도
  // DATE 컬럼을 두는 이유는 사용자 시간대에 따라 "하루"의 경계가 달라지기 때문이다.
  // 이 컬럼 도입 이전 로그는 null이라 어느 날짜 버킷에도 잡히지 않는다.
  recommended_date    DateTime?            @db.Date
  created_at          DateTime             @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // 백링크를 실제 관계로 건다. 문자열 컬럼만 두면 미션이 지워졌을 때 없는 id가 남고,
  // 다음 조회가 그 고아 백링크를 재사용해 미션을 복구하지 못한 채 응답한다.
  // 미션이 사라지면 null로 떨어뜨려(SetNull) 재생성 경로를 타게 한다.
  created_mission Missions? @relation("RecommendationLogCreatedMission", fields: [created_mission_id], references: [id], onDelete: SetNull)

  @@unique([user_id, recommended_date, refresh_index])
  @@index([user_id])
  @@index([user_id, recommended_date])
  @@index([created_mission_id])
  @@map("Recommendation_Logs")
}

