# 통합 테스트(npm run test:integration) 전용 환경 변수.
# .env.test로 복사해서 사용하세요 (.env.test는 gitignore 대상).
#
# 개발 DB(.env의 DATABASE_URL)와 반드시 다른 DB를 가리켜야 합니다 — 통합 테스트는 실제로
# 유저/추천로그 등을 생성·삭제하므로, 개발 DB를 그대로 쓰면 테스트가 중간에 죽었을 때
# 개발 데이터와 뒤섞이거나 테스트 잔여 데이터가 남을 수 있습니다.
# DATABASE_URL에 "test"라는 단어가 없으면 통합 테스트 실행 자체가 거부됩니다
# (jest.integration.setup.js 참고).
DATABASE_URL="mysql://root:password@localhost:3306/talkquest_test"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="integration-test-access-secret"
JWT_REFRESH_SECRET="integration-test-refresh-secret"
