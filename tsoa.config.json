{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/modules/**/controllers/*.controller.ts"],
  "spec": {
    "outputDirectory": "dist",
    "specVersion": 3,
    "name": "TalkQuest API",
    "description": "TalkQuest 백엔드 API 명세 (자동 생성)",
    "basePath": "/api/v1",
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "src/generated",
    "authenticationModule": "src/middlewares/tsoaAuthentication.ts"
  }
}
