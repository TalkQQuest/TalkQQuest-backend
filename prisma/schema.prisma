generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  active
  inactive
  deleted
}

enum Provider {
  email
  kakao
  naver
}

enum PersonalityType {
  introvert
  extrovert
  ambivert
}

enum TermsType {
  terms
  privacy
}

enum PrepItemType {
  question // 추천 질문
  starter // 대화 시작 문장
  tip // 준비 팁
}

// ----------------------------
// 미션 준비 정보(Mission_Setups)의 상황 설정 축
// 미션 창에서 사용자가 고르는 값이며, 그대로 대화 프롬프트(배역·말투)에 주입된다.
// 자유 문자열이 아니라 enum인 이유: 프롬프트가 값별로 분기하고, 미션 생성 시
// LLM이 "이 미션에서 말이 안 되는 조합"을 지목하려면 선택지 집합이 고정돼야 한다.
// ----------------------------
enum MissionEnvironment {
  school // 학교/대학교
  workplace // 직장
  daily_place // 동네·일상 공간 (카페, 헬스장, 편의점 등)
  community // 모임·커뮤니티 (동아리, 스터디, 소모임)
  online // 온라인 (SNS, 채팅)
}

enum MissionPartnerRole {
  friend // 친구
  senior // 선배
  junior // 후배
  peer // 동기/동료
  other // 그 외(초면·아는 지인 등) — 미션 성격상 위 선택지가 모두 불가능할 때 자동 선택된다
}

enum MissionPartnerGender {
  male
  female
}

enum MissionPartnerAgeGroup {
  teens // 10대
  twenties // 20대
  thirties // 30대
  forties // 40대
  fifties // 50대
  sixties_plus // 60대 이상
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum MessageRole {
  user
  guide
  system
}

enum MissionResult {
  success
  failure
  avoidance
}

enum MissionRecordStatus {
  in_progress
  completed
}

enum FeedbackStatus {
  pending
  ready
  failed
}

// 미션 추천 결과를 만든 단계 (Recommendation_Logs.source)
enum RecommendationSource {
  llm // 4단계 LLM 생성
  template // 3단계 템플릿 선택
  fallback // 매칭 실패 시 입문 하드 폴백
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum ArchiveItemType {
  conversation
  phrase
  report
  mission
}

enum DeviceTokenPlatform {
  android
  ios
}

enum CommunityVisibility {
  public
  private
}

enum CommunityStatus {
  draft
  open
  closed
}

enum CommunityMemberRole {
  host
  member
}

enum JoinRequestStatus {
  pending
  approved
  rejected
  cancelled
  waitlisted
}

enum ChatMessageType {
  text
  system
}

// ============================================================
// MODELS
// ============================================================

// ----------------------------
// Users
// 서비스 사용자 정보. 인증 수단은 Auth_Identities로 분리.
// ----------------------------
model Users {
  id              String     @id @default(uuid()) @db.Char(36)
  name            String     @db.VarChar(50)
  terms_agreed_at DateTime?
  created_at      DateTime   @default(now())
  last_login_at   DateTime?
  status          UserStatus @default(active)
  deleted_at      DateTime?

  // Relations
  auth_identities         Auth_Identities[]
  refresh_tokens          Refresh_Tokens[]
  user_profile            User_Profiles?
  goals                   Goals[]
  mission_saves           Mission_Saves[]
  conversations           Conversations[]
  mission_records         Mission_Records[]
  xp_history              XP_History[]
  feedbacks               Feedbacks[]
  saved_phrases           Saved_Phrases[]
  recommendation_logs     Recommendation_Logs[]
  usages                  Usage[]
  payments                Payments[]
  subscriptions           Subscriptions[]
  user_badges             User_Badges[]
  notifications           Notifications[]
  archive_folders         Archive_Folders[]
  archive_items           Archive_Items[]
  blocked_by_me           Blocked_Users[]           @relation("BlockedUsers_User")
  blocked_me              Blocked_Users[]           @relation("BlockedUsers_BlockedUser")
  device_tokens           Device_Tokens[]
  reports                 Reports[]
  login_history           Login_History[]
  notification_setting    Notification_Settings?
  hosted_communities      Communities[]             @relation("Communities_Host")
  chat_messages           Chat_Messages[]
  calendar_events         Calendar_Events[]
  community_join_requests Community_Join_Requests[]
  community_memberships   Community_Members[]
  community_bookmarks     Community_Bookmarks[]
  created_missions        Missions[]                @relation("MissionCreatedBy")
  mission_setups          Mission_Setups[]
  growth_profile          User_Growth_Profiles?

  @@map("Users")
}

// ----------------------------
// Auth_Identities
// 1 User : N 로그인 수단
// ----------------------------
model Auth_Identities {
  id               String   @id @default(uuid()) @db.Char(36)
  user_id          String   @db.Char(36)
  provider         Provider
  provider_user_id String?  @db.VarChar(255)
  email            String?  @db.VarChar(255)
  password_hash    String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@unique([provider, email])
  @@map("Auth_Identities")
}

// ----------------------------
// Refresh_Tokens
// ----------------------------
model Refresh_Tokens {
  id          String   @id @default(uuid()) @db.Char(36)
  user_id     String   @db.Char(36)
  token       String   @unique @db.VarChar(512)
  device_info Json?
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Refresh_Tokens")
}

// ----------------------------
// Terms
// ----------------------------
model Terms {
  id         String    @id @default(uuid()) @db.Char(36)
  type       TermsType
  version    String    @db.VarChar(20)
  content    String    @db.Text
  is_active  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("Terms")
}

// ----------------------------
// User_Profiles
// ----------------------------
model User_Profiles {
  id                      String           @id @default(uuid()) @db.Char(36)
  user_id                 String           @unique @db.Char(36)
  nickname                String?          @db.VarChar(50)
  status_type             String?          @db.VarChar(50)
  personality_type        PersonalityType?
  difficult_situations    Json?
  preferred_style         String?          @db.VarChar(255)
  interests               Json?
  purpose                 Json? // 연습하고 싶은 대화 유형 배열 (최대 2개)
  avatar_url              String?          @db.VarChar(500)
  bio                     String?          @db.Text
  daily_conversation_goal Int              @default(1)
  level                   Int              @default(1)
  xp                      Int              @default(0)
  onboarding_completed    Boolean          @default(false)
  onboarding_step         Int              @default(0)
  onboarding_temp_data    Json?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("User_Profiles")
}

// ----------------------------
// Goals
// ----------------------------
// ----------------------------
// User_Growth_Profiles
// 지난 수행 기록(대화·피드백)에서 뽑아낸 "이 사용자는 무엇을 잘하고 무엇에서 막히는가" 요약.
// 미션 추천이 읽는 유일한 이력 소스이며, 사용자당 1행이다.
//
// 왜 별도 테이블인가
//  - User_Profiles는 온보딩에서 사용자가 직접 고른 값이다. 여기 값은 시스템이 계산해 자주
//    덮어쓰는 파생 데이터라, 수명도 갱신 주기도 다르다. 섞으면 프로필을 읽는 모든 쿼리가
//    이 JSON 덩어리를 끌고 다닌다(Mission_Playbooks를 분리한 것과 같은 이유).
//  - 추천 때마다 Conversations·Conversation_Messages·Feedbacks를 조인해 원문을 프롬프트에
//    넣으면 토큰과 지연이 대화 수에 비례해 늘어난다. GET /missions/today는 사용자가 앱을 열면
//    바로 타는 경로라 그 비용을 감당할 수 없다. 그래서 피드백이 완성될 때 미리 요약해 두고,
//    추천은 이 한 행만 읽는다.
// ----------------------------
model User_Growth_Profiles {
  id      String @id @default(uuid()) @db.Char(36)
  user_id String @unique @db.Char(36)

  // 프롬프트에 그대로 주입할 2~3문장 서술 요약.
  // 구조화 필드만으로는 "질문은 잘 하는데 상대 답변을 받아 잇지 못한다" 같은 맥락이 사라진다.
  summary String? @db.Text

  // 반복 확인된 강점 / 개선점. Feedbacks.metrics의 strengths·improvements를 누적·정리한 것으로,
  // 1회성 지적이 아니라 여러 대화에 걸쳐 반복된 항목만 남긴다. string[] 형태.
  strengths    Json?
  improvements Json?

  // 반복해서 막힌 상황. 카테고리만이 아니라 Mission_Setups의 상황 축(환경/상대 역할 등)
  // 조합까지 담는다 — "카페는 괜찮은데 선배 상대만 막힌다"를 카테고리로는 표현할 수 없다.
  // [{ environment, partnerRole, category, lowScoreCount }] 형태.
  //
  // 카운터 이름이 failCount가 아니라 lowScoreCount인 이유 — 집계 기준이 Mission_Records.result가
  // 아니라 **피드백 지표 점수**다. 미션에는 실패라는 개념이 없어 result는 항상 success이므로,
  // 특정 상황 조합에서 지표가 반복적으로 낮게 나온 횟수를 센다.
  struggle_situations Json?

  // 피드백 지표 4종(kindness/initiative/empathy/questionLink)의 최근 평균과 추세.
  // { kindness: { avg, trend }, ... } 형태이며 trend는 up|down|flat.
  metric_averages Json?

  // 이력을 근거로 제안된 다음 난이도(1~3). 규칙 기반 결과를 대체하지 않고 비교 대상으로 쓴다 —
  // 최종 난이도는 규칙 기반 값 ±1 범위로 제한한다. 요약이 한 번 어긋났을 때 난이도가
  // 끝까지 튀어버리는 것을 막기 위한 안전장치다.
  suggested_difficulty Int? @db.TinyInt

  // 지금 요약이 몇 건의 피드백을 반영한 결과인지. 표본이 적을 때(예: 2건 미만)는 추천이
  // 이 요약을 신뢰하지 않고 기존 규칙 기반 경로만 쓰도록 판단하는 데 쓴다.
  reflected_feedback_count Int @default(0)

  // 증분 갱신 커서 — 여기까지 반영했다는 표시. 다음 갱신은 이 지점 뒤의 피드백만 읽는다.
  //
  // 커서 기준이 Feedbacks.created_at이 아니라 **ready_at(정렬 시 id로 타이브레이크)** 인 이유:
  // 피드백은 pending으로 먼저 만들어지고 나중에 ready가 된다. 생성 시각을 커서로 쓰면,
  // 먼저 생성됐지만 아직 pending인 A를 건너뛴 채 늦게 생성된 B가 커서를 밀어버리고,
  // A가 뒤늦게 ready가 돼도 생성 시각이 커서보다 앞이라 영영 집계에서 빠진다.
  // ready로 바뀐 순서를 따라가야 누락이 없다.
  //
  // last_feedback_id에 FK를 걸지 않은 것은 의도적이다. 참조된 피드백이 지워졌다고 커서가
  // null로 떨어지면 이미 반영한 이력을 처음부터 다시 요약하게 된다.
  // 같은 ready_at이 여러 건일 때 이 id가 타이브레이크 기준이 된다.
  last_feedback_id  String?   @db.Char(36)
  last_reflected_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("User_Growth_Profiles")
}

model Goals {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  goal_type  String   @db.VarChar(50)
  target     String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Goals")
}

// ----------------------------
// Missions
//
// 계층 원칙 — 미션 문구는 **환경·상대에 무관한 객관적 상황**으로 쓴다.
//   Missions          "처음 만난 사람에게 자기소개하고 이름 물어보기"  (여러 사용자가 공유)
//    └ Mission_Playbooks  그 상황의 세부 단계(뼈대)                   (미션당 1벌, 공유)
//        └ Mission_Setups 말투와 관계                                (대화 1회, 개인)
// 정보는 위에서 아래로만 흐른다. 위 두 계층은 공유되므로 한 사용자의 설정이 그쪽에 새면
// 다른 사용자에게까지 번진다. 상세는 docs/api/mission-setup-flow.md 참고.
// ----------------------------
model Missions {
  id                       String           @id @default(uuid()) @db.Char(36)
  title                    String           @db.VarChar(255)
  description              String           @db.Text
  preparation_tip          String?          @db.Text
  caution                  String?          @db.Text
  difficulty               Int
  estimated_minutes        Int
  reward_xp                Int              @default(0)
  category                 String           @db.VarChar(100)
  is_template              Boolean          @default(false)
  // AI 추천으로 생성된 미션의 생성자. 관리자 템플릿(is_template=true)과 이 컬럼 도입 이전에
  // 만들어진 미션은 null이다.
  created_by_user_id       String?          @db.Char(36)
  // 생성 당시 생성자의 성향. 생성자가 나중에 온보딩 성향을 바꿔도 "이 미션이 어떤 성향을 위해
  // 만들어졌는지"는 변하면 안 되므로 Users→User_Profiles 조인 대신 비정규화해 저장한다.
  // 미션 목록의 유사 성향 필터가 이 값을 그대로 쓴다.
  creator_personality_type PersonalityType?
  // 미션 창(상황 설정)이 그대로 쓰는 옵션 가이드라인. 미션을 만들 때 함께 생성해 굳혀 둔다.
  // { defaults, disabled, recommendedTopics, tags } 형태 —
  //   defaults: 미션 창 진입 시 미리 선택돼 있을 축별 기본 추천값
  //   disabled: 이 미션에서 말이 안 되는 선택지(앱이 비활성 처리). 예: 온라인 미션의 partnerGender
  //   recommendedTopics / tags: 주제·태그 추천 (Mission_Setups.selected_topic 후보)
  // 요청마다 LLM으로 다시 뽑지 않는 이유 — 같은 미션인데 진입할 때마다 비활성 항목이
  // 달라지면 사용자가 고른 값이 다음 진입에서 선택 불가가 되는 모순이 생긴다.
  // 상세 구조는 docs/api/mission-setup-guideline.md 참고.
  setup_guideline          Json?
  created_at               DateTime         @default(now())

  // Relations
  prep_items                  Mission_Prep_Items[]
  saves                       Mission_Saves[]
  conversations               Conversations[]
  mission_records             Mission_Records[]
  // 대화 진행 지침. 임베딩 때문에 1MB를 넘길 수 있어 별도 테이블로 뺐다 —
  // 필요한 곳에서만 명시적으로 join할 것(Missions를 select 없이 조회하면 딸려오지 않는다).
  playbook                    Mission_Playbooks?
  setups                      Mission_Setups[]
  created_by                  Users?                @relation("MissionCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  // 이 미션을 만들어낸 추천 로그들(백링크의 반대편).
  created_recommendation_logs Recommendation_Logs[] @relation("RecommendationLogCreatedMission")

  @@index([created_by_user_id])
  // 미션 목록 조회의 주 필터(템플릿 여부 + 유사 성향)를 한 인덱스로 커버한다.
  @@index([is_template, creator_personality_type])
  @@map("Missions")
}

// ----------------------------
// Mission_Prep_Items
// ----------------------------
// ----------------------------
// Mission_Playbooks
// 미션별 대화 진행 지침(flow + responseRules)과 그 임베딩.
//
// Missions에 JSON 컬럼으로 두었더니 미션 1건이 1.1MB까지 커졌다(임베딩 4096차원 × 10개를
// JSON 텍스트로 저장). select 없이 Missions를 조회하는 모든 쿼리가 이걸 통째로 끌고 왔고,
// ORDER BY가 걸리면 MySQL sort_buffer_size(256KB)를 넘겨 `GET /missions`가 500으로 죽었다.
// 별도 테이블로 빼서 **필요한 곳에서만 명시적으로 join**하게 한다.
// ----------------------------
model Mission_Playbooks {
  id         String   @id @default(uuid()) @db.Char(36)
  mission_id String   @unique @db.Char(36)
  // { flow: [{step, advanceExamples, advanceEmbeddings}], responseRules: [{when, then, whenEmbedding}] }
  data       Json
  created_at DateTime @default(now())
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP")) @db.Timestamp(0)

  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@map("Mission_Playbooks")
}

model Mission_Prep_Items {
  id          String       @id @default(uuid()) @db.Char(36)
  mission_id  String       @db.Char(36)
  type        PrepItemType
  content     String       @db.Text
  order_index Int          @default(0)
  created_at  DateTime     @default(now())

  mission Missions @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  // 첫 마디 후보는 캐시가 비었을 때 생성되는데, 조회와 삽입 사이에 잠금이 없어
  // 동시 요청이 모두 빈 캐시를 읽으면 같은 미션에 후보가 두 벌 쌓인다.
  // 이 제약이 있으면 뒤늦은 삽입이 skipDuplicates로 조용히 버려진다.
  @@unique([mission_id, type, order_index])
  @@map("Mission_Prep_Items")
}

// ----------------------------
// Mission_Saves
// ----------------------------
model Mission_Saves {
  id         String   @id @default(uuid()) @db.Char(36)
